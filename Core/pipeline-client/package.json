{
  "name": "@raccoonland/pipeline-client",
  "version": "0.2.0",
  "description": "PipelineResponse client, errors, and TanStack Query hooks",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "publishConfig": {
    "registry": "http://localhost:4873/"
  }
}
